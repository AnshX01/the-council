# Google Gemini API Key (Server-side only; NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Sensible defaults: gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Deliberation Orchestration Configuration
MAX_CONCURRENCY=4
SESSION_TIMEOUT_MS=300000
CALL_BUDGET=60
DEFAULT_MAX_ROUNDS=3

# Mock Provider Mode (set to true to run fully offline without API calls)
USE_MOCK_PROVIDER=false

# Local Server & Network Binding
PORT=3000
HOST=127.0.0.1
ENABLE_LAN=false

# Local SQLite Storage Path
DATABASE_PATH=./data/council.db

# Personal Spend Cap (USD)
MONTHLY_SPEND_CAP_USD=20.0

# Logging Verbosity (debug | info | warn | error)
LOG_LEVEL=info
