{
  "name": "the-council",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "lint:design": "npx tsx scripts/lint-design.ts",
    "typecheck": "tsc --noEmit",
    "council": "npx tsx scripts/council.ts",
    "backup": "npx tsx scripts/backup.ts",
    "restore": "npx tsx scripts/restore.ts",
    "reset-data": "npx tsx scripts/reset-data.ts",
    "verify": "npm run typecheck && npm run lint:design && npm test && npm run build && npm run test:e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:live": "vitest run tests/integration/liveGemini.test.ts",
    "diag:engine": "npx tsx scripts/diag-engine.ts",
    "clean-test-sessions": "npx tsx scripts/clean-test-sessions.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.5.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.477.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.6"
